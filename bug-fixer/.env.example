# .env.example — copy to .env and fill in your values

# ─── Required ────────────────────────────────────────────────────────────────

# Anthropic API key for Claude Code
ANTHROPIC_API_KEY=sk-ant-api03-...

# GitLab personal access token (needs: api scope)
GITLAB_TOKEN=glpat-...

# GitLab instance URL (use https://gitlab.com for gitlab.com)
GITLAB_URL=https://gitlab.com

# GitLab project — numeric ID or URL-encoded path (e.g. "my-group%2Fmy-project")
GITLAB_PROJECT_ID=12345

# Repository clone URL (used if LOCAL_REPO_PATH is not set)
REPO_URL=https://gitlab.com/your-group/your-repo.git

# Local repo: absolute path to a repo already on this machine.
# If set, the worker copies this instead of cloning from REPO_URL.
# Your local config, node_modules, build artifacts, etc. are preserved.
LOCAL_REPO_PATH=

# Webhook secret — set this in GitLab project > Settings > Webhooks
WEBHOOK_SECRET=your-webhook-secret-here

# ─── Behavior ───────────────────────────────────────────────────────────────

# Which Claude model to use
CLAUDE_MODEL=sonnet

# Max agentic turns for fix attempts
MAX_TURNS=25

# Worker poll interval in seconds
POLL_INTERVAL=10

# Default branch to target MRs against
TARGET_BRANCH=main

# Max times the webhook listener will revise an MR based on review feedback
MAX_REVISION_ROUNDS=3

# ─── Backend Docker Testing (optional) ──────────────────────────────────────
# Path to backend's docker-compose.yml relative to the repo root
BACKEND_DOCKER_COMPOSE=
BACKEND_SERVICE_NAME=backend
BACKEND_TEST_CMD=docker compose run --rm backend npm test
BACKEND_HEALTH_URL=
BACKEND_HEALTH_TIMEOUT_MS=30000
MAX_FIX_ITERATIONS=3

# Live backend access: agent can curl the backend directly and signal rebuilds
BACKEND_LIVE_ACCESS=false
BACKEND_PORT=3000

# ─── Ports ──────────────────────────────────────────────────────────────────

# API server port (receives bug reports)
API_PORT=3000

# Webhook listener port (receives GitLab events)
WEBHOOK_PORT=3001
