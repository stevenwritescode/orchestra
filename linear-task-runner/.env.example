# .env.example — copy to .env and fill in your values

# ─── Required ────────────────────────────────────────────────────────────────

# Git provider: "github" or "gitlab"
GIT_PROVIDER=gitlab

# Anthropic API key for Claude Code
ANTHROPIC_API_KEY=sk-ant-api03-...

# GitHub personal access token (required if GIT_PROVIDER=github, needs repo scope)
GITHUB_TOKEN=ghp_...

# GitHub repository (required if GIT_PROVIDER=github)
GITHUB_REPO=your-org/your-repo

# GitLab personal access token (required if GIT_PROVIDER=gitlab, needs: api scope)
GITLAB_TOKEN=glpat-...

# GitLab instance URL (required if GIT_PROVIDER=gitlab)
GITLAB_URL=https://gitlab.com

# GitLab project — numeric ID or "group/project" path (required if GIT_PROVIDER=gitlab)
GITLAB_PROJECT_ID=12345

# Repository clone URL (used if LOCAL_REPO_PATH is not set)
REPO_URL=https://gitlab.com/your-group/your-repo.git

# Local repo: absolute path to a repo already on this machine.
# If set, the orchestrator copies this into each container instead of cloning.
# Your local config, node_modules, build artifacts, etc. are all preserved.
# REPO_URL is still used for setting the git remote (push target).
LOCAL_REPO_PATH=

# ─── Linear Authentication ───────────────────────────────────────────────────
# Option A: API key (simpler, if your org allows it)
LINEAR_API_KEY=lin_api_...

# Option B: OAuth (for orgs that don't allow personal API keys)
# Create an OAuth app: https://linear.app/settings/api/applications/new
# Set redirect URI to: http://localhost:3456/callback
# Then run: node linear-oauth.mjs setup
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Where tokens are stored (default: .linear-tokens.json next to the script)
# LINEAR_TOKEN_FILE=
# LINEAR_REDIRECT_URI=http://localhost:3456/callback
# LINEAR_SCOPES=read,write

# ─── Linear Filters ─────────────────────────────────────────────────────────

# Only pick up issues with this label
LINEAR_LABEL=autofix

# Only pick up issues in this status column
LINEAR_STATUS=Todo

# ─── Behavior ───────────────────────────────────────────────────────────────

# Which Claude model to use ("sonnet" for cost efficiency, "opus" for harder tasks)
CLAUDE_MODEL=sonnet

# Max agentic turns per task
MAX_TURNS=25

# How often to check Linear for new tasks (milliseconds)
POLL_INTERVAL_MS=60000

# Max time per task before killing the container (milliseconds)
TASK_TIMEOUT_MS=600000

# Docker image name (built automatically on startup)
DOCKER_IMAGE=claude-task-runner

# Optional: path to a corporate proxy CA cert (e.g. Zscaler .pem/.crt).
# Only needed if your network does SSL inspection. Leave empty at home.
# Path is relative to the linear-task-runner/ directory.
CUSTOM_CA_CERT=

# ─── Backend Docker Testing (optional) ──────────────────────────────────────
# If your backend runs in Docker, the orchestrator can build and test it
# after the agent makes code changes. The agent never gets Docker access —
# the orchestrator handles all container operations on the host.

# Path to your backend's docker-compose.yml, relative to the repo root.
# Leave empty to skip backend Docker testing.
BACKEND_DOCKER_COMPOSE=

# Service name in the docker-compose file to build and start
BACKEND_SERVICE_NAME=backend

# Command the orchestrator runs to test the backend (runs on the host)
BACKEND_TEST_CMD=docker compose run --rm backend npm test

# Health check URL — orchestrator waits for 200 OK before running tests
BACKEND_HEALTH_URL=

# How long to wait for the health check (ms)
BACKEND_HEALTH_TIMEOUT_MS=30000

# How many times the orchestrator will rebuild + re-test after feeding
# failure output back to the agent
MAX_FIX_ITERATIONS=3

# ─── Live Backend Access (optional, requires BACKEND_DOCKER_COMPOSE) ────────
# When true, the agent can curl the backend directly instead of waiting
# for the orchestrator to run tests after it finishes.
# The orchestrator starts the backend before the agent, and watches for
# rebuild signals: the agent writes /workspace/signals/rebuild, the
# orchestrator rebuilds, then writes /workspace/signals/rebuild-done.
BACKEND_LIVE_ACCESS=false

# Port(s) the backend listens on. The firewall will allow ONLY these ports
# to the Docker host gateway. Comma-separated for multiple (e.g. "3000,5432").
BACKEND_PORT=3000
