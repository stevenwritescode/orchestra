# Orchestrator container — just needs Node and Docker CLI.
# This is NOT the sandboxed task runner (that's Dockerfile).

FROM node:22-slim

RUN apt-get update -qq && apt-get install -y -qq \
    curl \
    ca-certificates \
    && curl -fsSL https://get.docker.com | sh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
