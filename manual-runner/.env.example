# .env.example — copy to .env (or it will fall back to linear-task-runner/.env)
#
# Most settings are shared with linear-task-runner. Only set values here
# if you want to override them for manual runs.

# ─── Optional overrides ─────────────────────────────────────────────────────

# ANTHROPIC_API_KEY=sk-ant-...     # falls back to Claude Code OAuth login
# GIT_PROVIDER=gitlab              # or github
# GITLAB_TOKEN=glpat-...
# GITLAB_PROJECT_ID=12345
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=your-org/your-repo
# REPO_URL=https://gitlab.com/your/repo.git
# LOCAL_REPO_PATH=/path/to/local/repo
# CLAUDE_MODEL=sonnet
# MAX_TURNS=50
# TASK_TIMEOUT_MS=1800000
# CUSTOM_CA_CERT=certs/zscaler.pem
# DOCKER_IMAGE=claude-task-runner
